{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run day (pick)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/${input:day}/bin/Debug/net10.0/${input:day}.dll",
            "args": [],
            "cwd": "${workspaceFolder}/${input:day}",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ],
    "inputs": [
        {
            "id": "day",
            "type": "pickString",
            "description": "Który dzień uruchomić?",
            "options": [
                "Day01",
                "Day02",
                "Day03",
                "Day04",
                "Day05",
                "Day06",
                "Day07",
                "Day08",
                "Day09",
                "Day10",
                "Day11",
                "Day12"
            ],
            "default": "Day08"
        }
    ]
}
